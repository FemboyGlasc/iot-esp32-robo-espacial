// --------- Função de ativação ---------
float relu(float x) {
  return x > 0 ? x : 0;
}


float neuralNetwork(float temp, float umi, float luz, int movimento) {
  // Normalizar entradas
  float input[4] = {
    (temp - means[0]) / stds[0],
    (umi - means[1]) / stds[1],
    (luz - means[2]) / stds[2],
    (float)movimento
  };

  // Camada oculta 1
  float layer1[8] = {0};
  for (int i = 0; i < 8; i++) {
    layer1[i] = b1[i];
    for (int j = 0; j < 4; j++) {
      layer1[i] += input[j] * w1[j][i];
    }
    layer1[i] = relu(layer1[i]);
  }

  // Camada oculta 2
  float layer2[8] = {0};
  for (int i = 0; i < 8; i++) {
    layer2[i] = b2[i];
    for (int j = 0; j < 8; j++) {
      layer2[i] += layer1[j] * w2[j][i];
    }
    layer2[i] = relu(layer2[i]);
  }

  // Saída da rede neural
  float output = b3;
  for (int i = 0; i < 8; i++) {
    output += layer2[i] * w3[i];
  }

  // Aumentar em 30% se o PIR detectar movimento
  if (movimento == 1) {
    output *= 1.30;
  }

  return output;
}


